# --- 依赖与包管理 ---
node_modules/
.pnpm-store/
# 如果你确定不需要提交 lock 文件（通常建议提交）
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# --- VitePress 特有产物 ---
# 默认的静态构建输出目录
.vitepress/dist/
# VitePress 运行时的缓存目录
.vitepress/cache/
# 某些版本的临时文件
.temp/

# --- 环境变量与密钥 ---
# 包含敏感 API 密钥或 Token 的文件
.env
.env.local
.env.*.local
# 这里的 .env.example 建议不要忽略，用来做配置模板
!.env.example

# --- 日志文件 ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 操作系统及 IDE ---
# macOS
.DS_Store
# Windows
Thumbs.db
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
# IntelliJ / WebStorm
.idea/
*.iws
*.iml
*.ipr

# --- 测试与覆盖率 ---
coverage/
__snapshots__/

# --- 其他 ---
# 自动生成的本地临时文件
*.tmp
*.log